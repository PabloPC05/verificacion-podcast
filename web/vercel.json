{
 "redirects": [
  {
   "source": "/api/referencia",
   "destination": "/api",
   "permanent": true
  }
 ],
 "rewrites": [
  {
   "source": "/api",
   "destination": "/datos/index.html"
  },
  {
   "source": "/api/",
   "destination": "/datos/index.html"
  },
  {
   "source": "/api/v1/:ruta*",
   "destination": "/datos/v1/:ruta*"
  }
 ],
 "headers": [
  {
   "source": "/api/v1/(.*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=300"
    }
   ]
  },
  {
   "source": "/llms.txt",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    }
   ]
  },
  {
   "source": "/datos/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  }
 ]
}
