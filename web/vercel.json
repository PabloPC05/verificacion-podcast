{
 "redirects": [
  {
   "source": "/api/referencia",
   "destination": "/api",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/api/((?!estadisticas).*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=300"
    }
   ]
  },
  {
   "source": "/llms.txt",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    }
   ]
  }
 ]
}
